---
import '../styles/global.css';
---
<!doctype html>
<html lang="es" class="bg-background">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Menú Digital - O2 Restobar</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Orbitron:wght@700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="text-text-primary font-body relative min-h-[100dvh]">
		<div class="fixed top-0 left-0 w-full h-[100dvh] z-[-1] bg-background">
			<picture>
				<source media="(min-width: 768px)" srcset="/images/bg-desktop.webp">
				<img src="/images/bg-mobile.webp" alt="Fondo" class="w-full h-full object-cover opacity-100" />
			</picture>
			<!-- Capa oscura sobre el fondo: ajusta bg-zinc-950/55 para más o menos oscuridad -->
			<div class="absolute inset-0 bg-zinc-950/55 backdrop-blur-[1px]"></div>
		</div>
		<slot />
	</body>
</html>
