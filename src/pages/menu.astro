---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

import menuRooftopData from '../data/menu_rooftop.json';
import menuBurgerData from '../data/menu_burguer+.json';
import menuBarData from '../data/menu_bar.json';

// Helper para estructurar los menús con soporte de categorías y subcategorías
interface MenuItem {
  nombre: string;
  ingredientes?: string;
  precio?: number;
  precio_mediano?: number;
  precio_grande?: number;
  precio_sin_pulpa?: number;
  opciones?: string;
}

interface MenuSection {
  title: string;
  isTabla: boolean;
  items?: MenuItem[];
  subcategories?: {
    title: string;
    items: MenuItem[];
  }[];
}

function normalizeMenu(menuObj: Record<string, any>): MenuSection[] {
  return Object.entries(menuObj).map(([catName, catVal]) => {
    if (Array.isArray(catVal)) {
      return {
        title: catName,
        isTabla: catName.toLowerCase().includes('tabla'),
        items: catVal as MenuItem[]
      };
    } else {
      const subcategories = Object.entries(catVal).map(([subName, subItems]) => ({
        title: subName,
        items: Array.isArray(subItems) ? (subItems as MenuItem[]) : []
      }));
      return {
        title: catName,
        isTabla: false,
        subcategories
      };
    }
  });
}

const rooftopSections = normalizeMenu(menuRooftopData.menu);
const burgerSections = normalizeMenu(menuBurgerData.menu);
const barSections = normalizeMenu(menuBarData.menu);

// Mapeo de fotos disponibles
const dishImages: Record<string, string> = {
  "playa brava": "/images/playabrava.webp",
  "american burger+": "/images/hamburguesa.webp",
  "classic burger+": "/images/hamburguesamenu.webp",
  "lomo a lo pobre": "/images/lomopobre.webp",
  "salmón en salsa margarita": "/images/plato.webp",
  "hawai": "/images/hawaii.webp",
  "tropical gin": "/images/coctel.webp"
};

const getImage = (name: string) => {
  const clean = name.replace(/\(.*?\)/, '').trim().toLowerCase();
  return dishImages[clean] || undefined;
};
---

<Layout title="Carta Digital - O2 Restobar (Rooftop, Burger+ & Bar)">
  <!-- Script síncrono que corre antes del renderizado para evitar cualquier parpadeo de pestaña (FOUC) -->
  <script is:inline>
    (function() {
      const params = new URLSearchParams(window.location.search);
      let tab = params.get('tab') || 'rooftop';
      if (tab === 'comida') tab = 'rooftop';
      if (tab !== 'rooftop' && tab !== 'burger' && tab !== 'bar') tab = 'rooftop';

      const style = document.createElement('style');
      style.id = 'instantTabStyle';
      style.textContent = `
        #containerRooftop { display: ${tab === 'rooftop' ? 'flex' : 'none'} !important; }
        #containerBurger { display: ${tab === 'burger' ? 'flex' : 'none'} !important; }
        #containerBar { display: ${tab === 'bar' ? 'flex' : 'none'} !important; }
        
        #tabRooftop {
          background-color: ${tab === 'rooftop' ? 'rgba(250, 204, 21, 0.15)' : 'rgba(9, 9, 11, 0.5)'} !important;
          border-color: ${tab === 'rooftop' ? 'rgb(250 204 21)' : 'rgb(39 39 42)'} !important;
          color: ${tab === 'rooftop' ? 'rgb(250 204 21)' : 'rgb(161 161 170)'} !important;
          box-shadow: ${tab === 'rooftop' ? '0 0 15px rgba(250, 204, 21, 0.25)' : 'none'} !important;
        }
        #tabBurger {
          background-color: ${tab === 'burger' ? 'rgba(250, 204, 21, 0.15)' : 'rgba(9, 9, 11, 0.5)'} !important;
          border-color: ${tab === 'burger' ? 'rgb(250 204 21)' : 'rgb(39 39 42)'} !important;
          color: ${tab === 'burger' ? 'rgb(250 204 21)' : 'rgb(161 161 170)'} !important;
          box-shadow: ${tab === 'burger' ? '0 0 15px rgba(250, 204, 21, 0.25)' : 'none'} !important;
        }
        #tabBar {
          background-color: ${tab === 'bar' ? 'rgba(250, 204, 21, 0.15)' : 'rgba(9, 9, 11, 0.5)'} !important;
          border-color: ${tab === 'bar' ? 'rgb(250 204 21)' : 'rgb(39 39 42)'} !important;
          color: ${tab === 'bar' ? 'rgb(250 204 21)' : 'rgb(161 161 170)'} !important;
          box-shadow: ${tab === 'bar' ? '0 0 15px rgba(250, 204, 21, 0.25)' : 'none'} !important;
        }
      `;
      document.head.appendChild(style);
    })();
  </script>

  <!-- Cabecera fija con buscador y pestañas de los 3 menús -->
  <header class="fixed top-0 left-0 w-full bg-background/90 backdrop-blur-md z-50 border-b border-accent/20 shadow-md shadow-black/50 transition-all duration-300" id="mainHeader">
    <div class="max-w-3xl mx-auto px-3 sm:px-4 py-2 flex flex-col gap-2.5">
      
      <!-- Fila superior: Volver, Logo y Buscador -->
      <div class="flex items-center justify-between relative w-full h-14 transition-all duration-300" id="headerTopRow">
        <a 
          href="/" 
          class="flex items-center gap-1.5 text-text-secondary hover:text-accent font-headings text-xs uppercase tracking-wider transition-colors py-1 px-2 rounded-xs border border-transparent hover:border-accent/30 shrink-0"
          aria-label="Volver a la portada principal"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Inicio</span>
        </a>

        <!-- Logotipo Central -->
        <div id="logoContainer" class="flex justify-center transition-all duration-300">
          <a href="/" class="block" aria-label="O2 Restobar">
            <img src="/images/logo.webp" alt="O2 Restobar Logo" id="logoImg" class="h-9 sm:h-10 w-auto object-contain transition-all duration-300" loading="eager" fetchpriority="high" />
          </a>
        </div>
        
        <!-- Acciones: Búsqueda -->
        <div class="flex items-center gap-2 shrink-0">
          <button 
            id="searchTrigger" 
            aria-label="Buscar en la carta"
            class="text-text-primary hover:text-accent transition-colors p-2 rounded-xs hover:bg-zinc-900 border border-transparent hover:border-accent/30 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </div>

      <!-- Barra de Búsqueda Desplegable -->
      <div id="searchContainer" class="relative hidden opacity-0 transition-opacity duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-accent/60"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input 
          type="search" 
          id="searchInput" 
          placeholder="Buscar plato, ingrediente o trago..." 
          class="w-full bg-surface/80 border border-accent/50 rounded-xs pl-10 pr-10 py-2.5 text-text-primary placeholder-text-secondary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all font-body text-sm"
        />
        <button id="closeSearch" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary hover:text-accent cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <!-- Pestañas de Navegación de los 3 Menús -->
      <div class="flex gap-1.5 sm:gap-3 w-full">
        <!-- Pestaña 1: Rooftop -->
        <button id="tabRooftop" class="ds-tabs-active py-2 px-2 sm:px-4 text-xs font-headings font-bold flex items-center justify-center gap-1.5 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
          <span>Rooftop</span>
        </button>

        <!-- Pestaña 2: Burger+ -->
        <button id="tabBurger" class="ds-tabs-inactive py-2 px-2 sm:px-4 text-xs font-headings font-bold flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="text-sm">🍔</span>
          <span>Burger+</span>
        </button>

        <!-- Pestaña 3: Bar -->
        <button id="tabBar" class="ds-tabs-inactive py-2 px-2 sm:px-4 text-xs font-headings font-bold flex items-center justify-center gap-1.5 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h8"/><path d="M12 11v11"/><path d="m19 3-7 8-7-8Z"/></svg>
          <span>Bar</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Contenedor Principal de la Carta -->
  <main id="mainContent" class="max-w-3xl mx-auto p-4 flex flex-col gap-6 min-h-screen transition-all duration-300" style="padding-top: 150px;">

    <!-- Mensaje cuando no hay resultados de búsqueda -->
    <div id="noResultsMessage" class="hidden flex flex-col items-center justify-center text-center p-8 bg-zinc-950/80 border border-accent/40 rounded-xs my-6 animate-fade-up">
      <span class="text-3xl mb-2">🔍</span>
      <h3 class="font-headings font-bold text-base text-text-primary uppercase tracking-wider">
        Sin resultados para tu búsqueda
      </h3>
      <p class="text-xs text-text-secondary font-body mt-1 max-w-sm">
        No encontramos especialidades que coincidan con el término ingresado en esta carta.
      </p>
      <button 
        id="clearSearchBtn" 
        type="button" 
        class="mt-4 px-4 py-2 bg-accent text-zinc-950 font-headings font-bold text-xs uppercase tracking-wider hover:bg-accent-hover transition-all cursor-pointer"
      >
        Limpiar Búsqueda
      </button>
    </div>

    <!-- ========================================== -->
    <!-- 1. CARTA ROOFTOP (Platos, Tablas, Pizzas) -->
    <!-- ========================================== -->
    <div id="containerRooftop" class="menu-container flex flex-col gap-8 animate-fade-up">

      {rooftopSections.map((section) => (
        <section class="category-section">
          <!-- Cabecera con divisor dorado art-deco -->
          <div class="flex items-center gap-4 my-6">
            <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-accent/50 to-accent/80"></div>
            <h2 class="font-headings text-lg md:text-xl font-bold uppercase tracking-widest text-accent flex items-center gap-2 text-center">
              <span class="text-xs">✦</span>
              {section.title}
              <span class="text-xs">✦</span>
            </h2>
            <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-accent/50 to-accent/80"></div>
          </div>

          <!-- Banner Informativo Inspirado en el PDF para Tablas -->
          {section.isTabla && (
            <div class="mb-5 p-4 sm:p-5 bg-gradient-to-r from-zinc-950 via-zinc-900/90 to-zinc-950 border border-accent/40 rounded-xs shadow-md flex items-start gap-3">
              <span class="text-2xl text-accent">🍱</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-headings font-bold text-xs uppercase tracking-wider text-accent flex items-center gap-1.5">
                  ✦ NUESTRAS TABLAS · PARA COMPARTIR ✦
                </h3>
                <p class="text-text-secondary font-body text-xs leading-relaxed">
                  Porciones abundantes diseñadas para 3 a 4 personas. Carnes seleccionadas, frutos del mar y papas rústicas con recetas exclusivas de la Costanera.
                </p>
              </div>
            </div>
          )}

          <!-- Grid de productos -->
          {section.items && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {section.items.map((item) => (
                <Card 
                  nombre={item.nombre} 
                  descripcion={item.ingredientes} 
                  precio={item.precio}
                  opciones={item.opciones}
                  imagen={getImage(item.nombre)}
                  isTabla={section.isTabla}
                />
              ))}
            </div>
          )}

          {/* Subcategorías si existieran */}
          {section.subcategories && (
            <div class="flex flex-col gap-6">
              {section.subcategories.map((sub) => (
                <div class="sub-category-block">
                  <h3 class="text-sm font-headings font-bold uppercase tracking-wider text-accent/90 mb-3 pl-2.5 border-l-2 border-accent">
                    {sub.title}
                  </h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {sub.items.map((item) => (
                      <Card 
                        nombre={item.nombre} 
                        descripcion={item.ingredientes} 
                        precio={item.precio}
                        opciones={item.opciones}
                        imagen={getImage(item.nombre)}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- ========================================== -->
    <!-- 2. CARTA BURGER+ (Burgers, Hot Dogs, Marley) -->
    <!-- ========================================== -->
    <div id="containerBurger" class="menu-container flex flex-col gap-8 hidden animate-fade-up">

      <!-- Banner Dorado de Refill de Papas y Bebidas (del PDF) -->
      <div class="p-4 sm:p-5 bg-gradient-to-r from-accent/20 via-zinc-950 to-zinc-950 border-2 border-accent/60 rounded-xs shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-3xl">🍟🥤</span>
          <div>
            <h3 class="font-headings font-black text-sm sm:text-base text-accent uppercase tracking-wider">
              Papas y Bebidas Recargables
            </h3>
            <p class="font-body text-xs text-text-secondary leading-relaxed">
              Incluido con tus combos Burger+. Disfruta refill ilimitado en tu mesa.
            </p>
          </div>
        </div>
        <button 
          id="openRefillModal" 
          type="button" 
          class="shrink-0 px-3 py-1.5 bg-accent text-zinc-950 font-headings font-bold text-[11px] uppercase tracking-wider hover:bg-accent-hover transition-colors rounded-none cursor-pointer"
        >
          Reglas de Refill ℹ
        </button>
      </div>

      {burgerSections.map((section) => (
        <section class="category-section">
          <!-- Cabecera de Categoría -->
          <div class="flex items-center gap-4 my-6">
            <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-accent/50 to-accent/80"></div>
            <h2 class="font-headings text-lg md:text-xl font-bold uppercase tracking-widest text-accent flex items-center gap-2 text-center">
              <span class="text-xs">✦</span>
              {section.title}
              <span class="text-xs">✦</span>
            </h2>
            <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-accent/50 to-accent/80"></div>
          </div>

          <!-- Items directos -->
          {section.items && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {section.items.map((item) => (
                <Card 
                  nombre={item.nombre} 
                  descripcion={item.ingredientes} 
                  precio={item.precio}
                  precio_mediano={item.precio_mediano}
                  precio_grande={item.precio_grande}
                  precio_sin_pulpa={item.precio_sin_pulpa}
                  opciones={item.opciones}
                  imagen={getImage(item.nombre)}
                />
              ))}
            </div>
          )}

          <!-- Subcategorías (ej. Marley Coffee) -->
          {section.subcategories && (
            <div class="flex flex-col gap-6">
              {section.subcategories.map((sub) => (
                <div class="sub-category-block">
                  <h3 class="text-sm font-headings font-bold uppercase tracking-wider text-accent mb-3 pl-2.5 border-l-2 border-accent">
                    {sub.title}
                  </h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {sub.items.map((item) => (
                      <Card 
                        nombre={item.nombre} 
                        descripcion={item.ingredientes} 
                        precio={item.precio}
                        precio_mediano={item.precio_mediano}
                        precio_grande={item.precio_grande}
                        precio_sin_pulpa={item.precio_sin_pulpa}
                        opciones={item.opciones}
                        imagen={getImage(item.nombre)}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- ========================================== -->
    <!-- 3. CARTA BAR (Coctelería, Destilados, Vinos) -->
    <!-- ========================================== -->
    <div id="containerBar" class="menu-container flex flex-col gap-8 hidden animate-fade-up">

      {barSections.map((section) => (
        <section class="category-section">
          <!-- Cabecera de Categoría -->
          <div class="flex items-center gap-4 my-6">
            <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-accent/50 to-accent/80"></div>
            <h2 class="font-headings text-lg md:text-xl font-bold uppercase tracking-widest text-accent flex items-center gap-2 text-center">
              <span class="text-xs">✦</span>
              {section.title}
              <span class="text-xs">✦</span>
            </h2>
            <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-accent/50 to-accent/80"></div>
          </div>

          <!-- Items directos -->
          {section.items && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {section.items.map((item) => (
                <Card 
                  nombre={item.nombre} 
                  descripcion={item.ingredientes} 
                  precio={item.precio}
                  precio_sin_pulpa={item.precio_sin_pulpa}
                  imagen={getImage(item.nombre)}
                />
              ))}
            </div>
          )}

          <!-- Subcategorías (ej. Coctelería Clásica y Destilados por licor) -->
          {section.subcategories && (
            <div class="flex flex-col gap-6">
              {section.subcategories.map((sub) => (
                <div class="sub-category-block">
                  <h3 class="text-sm font-headings font-bold uppercase tracking-wider text-accent mb-3 pl-2.5 border-l-2 border-accent">
                    {sub.title}
                  </h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {sub.items.map((item) => (
                      <Card 
                        nombre={item.nombre} 
                        descripcion={item.ingredientes} 
                        precio={item.precio}
                        precio_sin_pulpa={item.precio_sin_pulpa}
                        imagen={getImage(item.nombre)}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  </main>

  <!-- Modal de Instrucciones de Refill (Páginas 5 y 6 del PDF) -->
  <div id="refillModal" class="fixed inset-0 z-[120] bg-black/85 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="relative max-w-md w-full bg-zinc-950 border-2 border-accent p-6 rounded-none shadow-2xl animate-fade-up">
      <div class="flex items-start justify-between gap-4 border-b border-dashed border-accent/40 pb-3 mb-4">
        <div>
          <span class="text-[10px] font-headings font-extrabold text-accent uppercase tracking-widest">Burger+ Experience</span>
          <h3 class="font-headings font-bold text-base uppercase tracking-wider text-text-primary">
            Instrucciones de Refill
          </h3>
        </div>
        <button id="closeRefillModal" aria-label="Cerrar modal de refill" class="text-accent hover:text-white text-lg font-bold p-1 cursor-pointer">
          ✕
        </button>
      </div>

      <ul class="flex flex-col gap-2.5 text-xs text-text-secondary font-body leading-relaxed">
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span>Se activa cuando <strong>todas las personas en la mesa</strong> pidan productos con refill.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span><strong>Duración:</strong> mientras permanezcan en mesa.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span><strong>Refill de Cerveza:</strong> dura 90 min y tiene un valor adicional de <strong>$1.900</strong>.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span>La recarga de papas debe ser con el canasto vacío.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span>La recarga de bebida debe ser con el vaso vacío.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-accent font-bold">✔</span>
          <span>Envase para llevar: valor <strong>$500</strong>.</span>
        </li>
      </ul>

      <div class="mt-5 pt-3 border-t border-accent/30 text-center">
        <button id="confirmRefillModal" class="w-full py-2 bg-accent text-zinc-950 font-headings font-bold text-xs uppercase tracking-wider hover:bg-accent-hover transition-all cursor-pointer">
          Entendido
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const tabRooftop = document.getElementById('tabRooftop');
  const tabBurger = document.getElementById('tabBurger');
  const tabBar = document.getElementById('tabBar');

  const containerRooftop = document.getElementById('containerRooftop');
  const containerBurger = document.getElementById('containerBurger');
  const containerBar = document.getElementById('containerBar');

  const searchTrigger = document.getElementById('searchTrigger');
  const closeSearch = document.getElementById('closeSearch');
  const searchContainer = document.getElementById('searchContainer');
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const logoContainer = document.getElementById('logoContainer');
  const logoImg = document.getElementById('logoImg');
  const mainContent = document.getElementById('mainContent');

  // Modal Refill
  const refillModal = document.getElementById('refillModal');
  const openRefillBtn = document.getElementById('openRefillModal');
  const closeRefillBtn = document.getElementById('closeRefillModal');
  const confirmRefillBtn = document.getElementById('confirmRefillModal');

  function openRefill() {
    if (!refillModal) return;
    refillModal.classList.remove('hidden');
    setTimeout(() => refillModal.classList.remove('opacity-0'), 10);
  }

  function closeRefill() {
    if (!refillModal) return;
    refillModal.classList.add('opacity-0');
    setTimeout(() => refillModal.classList.add('hidden'), 300);
  }

  if (openRefillBtn) openRefillBtn.addEventListener('click', openRefill);
  if (closeRefillBtn) closeRefillBtn.addEventListener('click', closeRefill);
  if (confirmRefillBtn) confirmRefillBtn.addEventListener('click', closeRefill);
  if (refillModal) {
    refillModal.addEventListener('click', (e) => {
      if (e.target === refillModal) closeRefill();
    });
  }

  // Elementos de la Búsqueda y Resultados
  const noResultsMessage = document.getElementById('noResultsMessage');
  const clearSearchBtn = document.getElementById('clearSearchBtn');

  // Normalizador de texto para español (ignora tildes, mayúsculas y espacios extra)
  function normalizeText(str: string | null | undefined): string {
    return (str || '')
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();
  }

  // Restablece absolutamente todos los elementos en todas las pestañas sin dejar residuos
  function resetAllFilters() {
    const allFiltered = document.querySelectorAll('.menu-item, .sub-category-block, .category-section');
    allFiltered.forEach(el => {
      (el as HTMLElement).style.display = '';
    });
    if (noResultsMessage) {
      noResultsMessage.classList.add('hidden');
    }
  }

  // Aplica el filtro en un contenedor específico
  function filterContainer(container: HTMLElement, rawTerm: string): number {
    const term = normalizeText(rawTerm);
    if (!term) {
      container.querySelectorAll('.menu-item, .sub-category-block, .category-section').forEach(el => {
        (el as HTMLElement).style.display = '';
      });
      return 1;
    }

    let totalVisibleInContainer = 0;
    const sections = container.querySelectorAll('.category-section');

    sections.forEach(section => {
      let sectionHasVisible = false;
      const subBlocks = section.querySelectorAll('.sub-category-block');

      if (subBlocks.length > 0) {
        // La sección tiene subcategorías (ej: Destilados, Marley Coffee)
        subBlocks.forEach(sub => {
          let subHasVisible = false;
          const subCards = sub.querySelectorAll('.menu-item');

          subCards.forEach(card => {
            const nombre = normalizeText(card.getAttribute('data-nombre'));
            const desc = normalizeText(card.getAttribute('data-descripcion'));
            if (nombre.includes(term) || desc.includes(term)) {
              (card as HTMLElement).style.display = '';
              subHasVisible = true;
              sectionHasVisible = true;
              totalVisibleInContainer++;
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });

          (sub as HTMLElement).style.display = subHasVisible ? '' : 'none';
        });
      } else {
        // Sección estándar directa sin subcategorías
        const cards = section.querySelectorAll('.menu-item');
        cards.forEach(card => {
          const nombre = normalizeText(card.getAttribute('data-nombre'));
          const desc = normalizeText(card.getAttribute('data-descripcion'));
          if (nombre.includes(term) || desc.includes(term)) {
            (card as HTMLElement).style.display = '';
            sectionHasVisible = true;
            totalVisibleInContainer++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      }

      (section as HTMLElement).style.display = sectionHasVisible ? '' : 'none';
    });

    return totalVisibleInContainer;
  }

  function runSearch() {
    if (!searchInput) return;
    const rawTerm = searchInput.value;
    const term = normalizeText(rawTerm);

    if (!term) {
      resetAllFilters();
      return;
    }

    const activeContainer = document.querySelector('.menu-container:not(.hidden)') as HTMLElement | null;
    if (!activeContainer) return;

    const visibleCount = filterContainer(activeContainer, term);

    if (noResultsMessage) {
      if (visibleCount === 0) {
        noResultsMessage.classList.remove('hidden');
      } else {
        noResultsMessage.classList.add('hidden');
      }
    }
  }

  function closeSearchBar() {
    if (!searchContainer || !searchTrigger) return;
    searchContainer.classList.add('opacity-0');
    setTimeout(() => {
      searchContainer.classList.add('hidden');
      searchTrigger.classList.remove('hidden');
      if (logoContainer) logoContainer.classList.remove('opacity-0', 'pointer-events-none');
    }, 300);

    if (mainContent) mainContent.style.paddingTop = '150px';
    if (searchInput) searchInput.value = '';
    resetAllFilters();
  }

  function openSearchBar() {
    if (!searchContainer || !searchTrigger || !searchInput) return;
    searchTrigger.classList.add('hidden');
    if (logoContainer) logoContainer.classList.add('opacity-0', 'pointer-events-none');
    if (mainContent) mainContent.style.paddingTop = '190px';

    searchContainer.classList.remove('hidden');
    setTimeout(() => {
      searchContainer.classList.remove('opacity-0');
      searchInput.focus();
    }, 10);
  }

  searchTrigger?.addEventListener('click', openSearchBar);
  closeSearch?.addEventListener('click', closeSearchBar);
  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    closeSearchBar();
  });

  // Escuchar múltiples eventos para cubrir teclado móvil, botón 'x' nativo de input search, y pegado
  if (searchInput) {
    ['input', 'search', 'change', 'keyup'].forEach(evt => {
      searchInput.addEventListener(evt, () => {
        if (!searchInput.value) {
          resetAllFilters();
        } else {
          runSearch();
        }
      });
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearchBar();
      }
    });
  }

  // Switch de Pestañas entre los 3 Menús
  function switchTab(activeTabName: 'rooftop' | 'burger' | 'bar') {
    const instantStyle = document.getElementById('instantTabStyle');
    if (instantStyle) instantStyle.remove();

    const tabs = [
      { name: 'rooftop', btn: tabRooftop, container: containerRooftop },
      { name: 'burger', btn: tabBurger, container: containerBurger },
      { name: 'bar', btn: tabBar, container: containerBar }
    ];

    tabs.forEach(t => {
      if (t.name === activeTabName) {
        if (t.btn) {
          t.btn.className = 'ds-tabs-active py-2 px-2 sm:px-4 text-xs font-headings font-bold flex items-center justify-center gap-1.5 cursor-pointer';
        }
        if (t.container) {
          t.container.classList.remove('hidden');
          // Al activar pestaña, si hay búsqueda activa, filtrar ese contenedor; si no, resetearlo
          if (searchInput && searchInput.value.trim()) {
            filterContainer(t.container, searchInput.value);
          } else {
            t.container.querySelectorAll('.menu-item, .sub-category-block, .category-section').forEach(el => {
              (el as HTMLElement).style.display = '';
            });
          }
        }
      } else {
        if (t.btn) {
          t.btn.className = 'ds-tabs-inactive py-2 px-2 sm:px-4 text-xs font-headings font-bold flex items-center justify-center gap-1.5 cursor-pointer';
        }
        if (t.container) {
          t.container.classList.add('hidden');
          // Siempre limpiar estilos inline del contenedor inactivo para evitar estados residuales
          t.container.querySelectorAll('.menu-item, .sub-category-block, .category-section').forEach(el => {
            (el as HTMLElement).style.display = '';
          });
        }
      }
    });

    // Actualizar parámetro en la URL
    const url = new URL(window.location.href);
    url.searchParams.set('tab', activeTabName);
    window.history.replaceState(null, '', url.toString());

    // Actualizar estado de noResults
    if (searchInput && searchInput.value.trim()) {
      runSearch();
    } else if (noResultsMessage) {
      noResultsMessage.classList.add('hidden');
    }
  }

  tabRooftop?.addEventListener('click', () => switchTab('rooftop'));
  tabBurger?.addEventListener('click', () => switchTab('burger'));
  tabBar?.addEventListener('click', () => switchTab('bar'));

  // Sincronizar estado inicial al cargar JS
  const urlParams = new URLSearchParams(window.location.search);
  const initialTab = urlParams.get('tab');
  if (initialTab === 'burger') {
    switchTab('burger');
  } else if (initialTab === 'bar') {
    switchTab('bar');
  } else {
    switchTab('rooftop');
  }
</script>
