---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import menuBarData from '../data/menu_bar.json';
import menuComidaData from '../data/menu_comida.json';

const barCategories = menuBarData.menu_bar;
const foodCategories = menuComidaData.menu_comida;

// Recomendaciones de la casa
const featuredNames = ["AMERICAN BURGER+", "LOMO A LO POBRE", "HAWAI", "PLAYA BRAVA"];
const allItems = [...barCategories, ...foodCategories].flatMap(cat => cat.items);
const featuredItems = featuredNames.map(name => allItems.find(item => item.nombre === name));
---
<Layout>
  <header class="w-full flex justify-center pt-8 pb-4 relative z-10 px-4">
    <!-- Outer Border Box -->
    <div class="relative w-full max-w-[420px] border border-accent/50 p-2 shadow-2xl shadow-black/80 overflow-hidden bg-zinc-950/20 backdrop-blur-[1px]">
      <!-- Decorative Dark/Gold Corners -->
      <div class="absolute -top-12 -left-12 w-24 h-24 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
      <div class="absolute -top-12 -right-12 w-24 h-24 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
      <div class="absolute -bottom-12 -left-12 w-24 h-24 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
      <div class="absolute -bottom-12 -right-12 w-24 h-24 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
      
      <!-- Inner Border Box -->
      <div class="relative z-10 w-full border-[3px] border-accent py-12 px-4 flex flex-col items-center">
        <!-- Corner Accents (Inner Box) -->
        <div class="absolute -top-1.5 -left-1.5 w-3 h-3 bg-zinc-950 border border-accent"></div>
        <div class="absolute -top-1.5 -right-1.5 w-3 h-3 bg-zinc-950 border border-accent"></div>
        <div class="absolute -bottom-1.5 -left-1.5 w-3 h-3 bg-zinc-950 border border-accent"></div>
        <div class="absolute -bottom-1.5 -right-1.5 w-3 h-3 bg-zinc-950 border border-accent"></div>

        <!-- Logo (Replacing text with standalone logo) -->
        <img src="/images/logo.webp" alt="O2 Restobar Logo" class="h-28 w-auto object-contain mb-8 drop-shadow-xl" />

        <!-- CARTA Text -->
        <div class="flex items-center gap-4 text-text-primary text-2xl md:text-3xl font-light tracking-[0.35em] mb-8">
          <span class="text-accent text-xl">✦</span>
          <span class="flex text-center ">OXIGENO MULTIESPACIO</span>
          
          <span class="text-accent text-xl">✦</span>
        </div>

        <!-- Cocktail Glass SVG -->
        <svg viewBox="0 0 100 85" class="w-36 h-auto mx-auto text-accent drop-shadow-[0_0_8px_rgba(250,204,21,0.4)] mb-8" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter">
          <!-- Main triangle -->
          <polygon points="10,15 90,15 50,55" />
          <!-- Stem -->
          <line x1="50" y1="55" x2="50" y2="70" stroke-width="4" stroke-linecap="round" />
          <!-- Wavy line -->
          <path d="M 25,30 Q 40,20 50,30 T 75,25" stroke-width="3" stroke-linecap="round" />
          <!-- Inner parallel line -->
          <line x1="20" y1="15" x2="42" y2="37" stroke-width="3" />
        </svg>

        <!-- BAR Text -->
        <div class="flex items-center justify-center gap-6 mb-12 w-full">
          <div class="w-3 h-3 rounded-full bg-accent shadow-[0_0_8px_rgba(250,204,21,0.6)]"></div>
          <h1 class="text-text-primary font-headings font-black text-4xl md:text-8xl tracking-tighter" style="transform: scaleY(1.4);">CARTA</h1>
          <div class="w-3 h-3 rounded-full bg-accent shadow-[0_0_8px_rgba(250,204,21,0.6)]"></div>
        </div>

        <!-- Footer Quote -->
        <div class="w-full max-w-[95%] flex flex-col items-center border-y-2 border-accent py-4 mt-2">
          <p class="text-text-primary text-center text-[10px] md:text-xs font-bold tracking-widest leading-loose uppercase">
            Tus recuerdos se disfrutan mejor<br/>
            con un vaso en la mano,<br/>
            el contenido del vaso lo eliges tú
          </p>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto p-4 flex flex-col gap-12 min-h-screen pb-20 relative z-10">
    
    <section class="flex flex-col gap-6">
      <div class="flex items-center gap-4 my-2">
        <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-accent/50 to-accent/80"></div>
        <h2 class="font-headings font-bold text-xl md:text-2xl uppercase tracking-wider text-accent text-center flex items-center gap-2 drop-shadow-[0_0_8px_rgba(250,204,21,0.3)]">
          <span class="text-xs">✦</span>
          Platos estrella
          <span class="text-xs">✦</span>
        </h2>
        <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-accent/50 to-accent/80"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {featuredItems.map((item) => (
          item ? <Card nombre={item.nombre} descripcion={item.descripcion} precio={item.precio} /> : null
        ))}
      </div>
    </section>

    <nav class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
      <!-- Botón Carta de Bar -->
      <a 
        href="/menu?tab=bar" 
        class="group relative w-full border border-accent/50 p-2 shadow-2xl shadow-black/80 overflow-hidden bg-zinc-950/20 backdrop-blur-[1px] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] animate-gold-glow block"
      >
        <!-- Esquinas angulares oscuras / doradas rotadas (exacto al Hero) -->
        <div class="absolute -top-9 -left-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -top-9 -right-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -bottom-9 -left-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -bottom-9 -right-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>

        <!-- Reflejo de luz pasivo (shimmer) -->
        <div class="absolute inset-0 w-1/2 bg-gradient-to-r from-transparent via-accent/20 to-transparent pointer-events-none animate-shimmer z-20"></div>

        <!-- Marco interior dorado con muescas en las esquinas -->
        <div class="relative z-10 w-full border-[2.5px] border-accent py-8 px-4 flex flex-col items-center text-center transition-colors group-hover:border-accent-hover">
          <!-- Acentos de esquina marco interior -->
          <div class="absolute -top-1 -left-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -bottom-1 -left-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>


          <!-- Icono Copa de Bar (coherente con el Hero) -->
          <svg viewBox="0 0 100 85" class="w-20 h-auto mx-auto text-accent drop-shadow-[0_0_8px_rgba(250,204,21,0.4)] mb-3 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter">
            <polygon points="12,16 88,16 50,55" />
            <line x1="50" y1="55" x2="50" y2="70" stroke-width="3.5" stroke-linecap="round" />
            <path d="M 26,30 Q 40,22 50,30 T 74,26" stroke-width="2.5" stroke-linecap="round" />
            <line x1="22" y1="16" x2="42" y2="36" stroke-width="2.5" />
          </svg>

          <!-- Título BAR con puntos dorados laterales -->
          <div class="flex items-center justify-center gap-4 my-2 w-full">
            <div class="w-2.5 h-2.5 rounded-full bg-accent shadow-[0_0_6px_rgba(250,204,21,0.6)]"></div>
            <h3 class="text-text-primary font-headings font-black text-4xl md:text-5xl tracking-tighter group-hover:text-accent transition-colors" style="transform: scaleY(1.3);">
              BAR
            </h3>
            <div class="w-2.5 h-2.5 rounded-full bg-accent shadow-[0_0_6px_rgba(250,204,21,0.6)]"></div>
          </div>

          <!-- Línea inferior con acción y flecha -->
          <div class="w-full max-w-[85%] border-t border-accent/60 pt-3 mt-4 flex items-center justify-center gap-2 text-accent text-[11px] font-bold tracking-widest uppercase">
            <span>Explorar Coctelería</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </div>
        </div>
      </a>

      <!-- Botón Carta de Comida -->
      <a 
        href="/menu?tab=comida" 
        class="group relative w-full border border-accent/50 p-2 shadow-2xl shadow-black/80 overflow-hidden bg-zinc-950/20 backdrop-blur-[1px] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] animate-gold-glow block"
        style="animation-delay: 1.75s;"
      >
        <!-- Esquinas angulares oscuras / doradas rotadas (exacto al Hero) -->
        <div class="absolute -top-9 -left-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -top-9 -right-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -bottom-9 -left-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>
        <div class="absolute -bottom-9 -right-9 w-18 h-18 bg-zinc-950 border border-accent/80 rotate-45 z-0 shadow-lg"></div>

        <!-- Reflejo de luz pasivo (shimmer con desfase) -->
        <div class="absolute inset-0 w-1/2 bg-gradient-to-r from-transparent via-accent/20 to-transparent pointer-events-none animate-shimmer z-20" style="animation-delay: 2.25s;"></div>

        <!-- Marco interior dorado con muescas en las esquinas -->
        <div class="relative z-10 w-full border-[2.5px] border-accent py-8 px-4 flex flex-col items-center text-center transition-colors group-hover:border-accent-hover">
          <!-- Acentos de esquina marco interior -->
          <div class="absolute -top-1 -left-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -bottom-1 -left-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>
          <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-zinc-950 border border-accent"></div>

          <!-- Icono Campana Gourmet de Comida (coherente con el Hero) -->
          <svg viewBox="0 0 100 85" class="w-20 h-auto mx-auto text-accent drop-shadow-[0_0_8px_rgba(250,204,21,0.4)] mb-3 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter">
            <!-- Campana / Cloche -->
            <path d="M 18,54 A 32,32 0 0,1 82,54 Z" />
            <!-- Manilla campana -->
            <circle cx="50" cy="22" r="3.5" fill="currentColor" />
            <!-- Plato base -->
            <line x1="10" y1="62" x2="90" y2="62" stroke-width="3.5" stroke-linecap="round" />
            <!-- Línea interna de brillo -->
            <path d="M 32,42 Q 50,34 68,42" stroke-width="2.5" stroke-linecap="round" />
          </svg>

          <!-- Título COMIDA con puntos dorados laterales -->
          <div class="flex items-center justify-center gap-4 my-2 w-full">
            <div class="w-2.5 h-2.5 rounded-full bg-accent shadow-[0_0_6px_rgba(250,204,21,0.6)]"></div>
            <h3 class="text-text-primary font-headings font-black text-4xl md:text-5xl tracking-tighter group-hover:text-accent transition-colors" style="transform: scaleY(1.3);">
              COMIDA
            </h3>
            <div class="w-2.5 h-2.5 rounded-full bg-accent shadow-[0_0_6px_rgba(250,204,21,0.6)]"></div>
          </div>

          <!-- Línea inferior con acción y flecha -->
          <div class="w-full max-w-[85%] border-t border-accent/60 pt-3 mt-4 flex items-center justify-center gap-2 text-accent text-[11px] font-bold tracking-widest uppercase">
            <span>Explorar Gastronomía</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </div>
        </div>
      </a>
    </nav>
  </main>
</Layout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fade-up');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.menu-item').forEach(card => {
    card.classList.add('opacity-0');
    observer.observe(card);
  });
</script>
