---
interface Props {
  nombre: string;
  descripcion: string;
  precio: number;
  imagen?: string;
}

const { nombre, descripcion, precio, imagen } = Astro.props;
const formattedPrice = new Intl.NumberFormat('es-CL', {
  style: 'currency',
  currency: 'CLP',
  maximumFractionDigits: 0
}).format(precio);
---
<div 
  class={`ds-card menu-item h-full group ${imagen ? 'card-with-image cursor-pointer hover:border-accent/80 transition-all' : ''}`} 
  data-nombre={nombre.toLowerCase()} 
  data-descripcion={descripcion.toLowerCase()}
  data-has-image={imagen ? "true" : "false"}
>
  <!-- Acentos angulares de esquina dorados (estilo congruente con la carta) -->
  <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 border-t-2 border-l-2 border-accent/70 group-hover:border-accent group-hover:shadow-[0_0_6px_rgba(250,204,21,0.6)] transition-all"></div>
  <div class="absolute -top-[1px] -right-[1px] w-2.5 h-2.5 border-t-2 border-r-2 border-accent/70 group-hover:border-accent group-hover:shadow-[0_0_6px_rgba(250,204,21,0.6)] transition-all"></div>
  <div class="absolute -bottom-[1px] -left-[1px] w-2.5 h-2.5 border-b-2 border-l-2 border-accent/70 group-hover:border-accent group-hover:shadow-[0_0_6px_rgba(250,204,21,0.6)] transition-all"></div>
  <div class="absolute -bottom-[1px] -right-[1px] w-2.5 h-2.5 border-b-2 border-r-2 border-accent/70 group-hover:border-accent group-hover:shadow-[0_0_6px_rgba(250,204,21,0.6)] transition-all"></div>

  <div class="flex items-start justify-between gap-3">
    <h3 class="font-body font-bold text-base md:text-lg text-text-primary group-hover:text-accent tracking-wide transition-colors">
      {nombre}
    </h3>
    <span class="ds-price-badge font-body text-white shrink-0">{formattedPrice}</span>
  </div>

  {descripcion && (
    <p class="text-text-secondary text-xs md:text-sm font-body leading-relaxed flex-1 mt-1">
      {descripcion}
    </p>
  )}

  {imagen && (
    <div>
      {/* Indicador de foto disponible */}
      <div class="flex items-center justify-between mt-3 pt-2 border-t border-accent/20">
        <span class="inline-flex items-center gap-1.5 text-accent font-medium tracking-wider uppercase text-[11px] group-hover:text-accent-hover transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
            <circle cx="12" cy="13" r="3"/>
          </svg>
          <span class="toggle-text">Ver foto</span>
        </span>
        <span class="toggle-arrow text-accent/70 text-[10px] transition-transform duration-300">▼</span>
      </div>

      {/* Contenedor de la imagen (0 bytes cargados inicialmente hasta hacer clic) */}
      <div class="image-container overflow-hidden max-h-0 opacity-0 transition-all duration-500 ease-out">
        <div class="relative mt-3 rounded-lg overflow-hidden border border-accent/40 bg-zinc-950/90 aspect-video flex items-center justify-center shadow-inner">
          {/* Skeleton de carga animado con destello dorado */}
          <div class="skeleton-loader absolute inset-0 bg-gradient-to-r from-zinc-900 via-zinc-800 to-zinc-900 animate-pulse flex items-center justify-center">
            <svg class="animate-spin h-5 w-5 text-accent/60" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          {/* Imagen que solo recibe su src cuando el usuario hace clic */}
          <img 
            data-src={imagen} 
            alt={`Foto de ${nombre}`} 
            class="dish-img w-full h-full object-cover opacity-0 transition-opacity duration-300 relative z-10 hover:scale-105 transition-transform"
          />
        </div>
        <p class="text-[10px] text-accent/60 text-center mt-1 italic tracking-wide">Toca la foto para ampliar</p>
      </div>
    </div>
  )}
</div>

<script>
  // Manejo de carga bajo demanda y expansión al hacer clic en la tarjeta
  document.querySelectorAll('.card-with-image').forEach((card) => {
    // Evitar agregar múltiples listeners si el script se evalúa nuevamente
    if (card.getAttribute('data-has-listener') === 'true') return;
    card.setAttribute('data-has-listener', 'true');

    const container = card.querySelector('.image-container') as HTMLElement | null;
    const img = card.querySelector('.dish-img') as HTMLImageElement | null;
    const loader = card.querySelector('.skeleton-loader') as HTMLElement | null;
    const toggleText = card.querySelector('.toggle-text');
    const toggleArrow = card.querySelector('.toggle-arrow');

    if (!container || !img) return;

    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      
      // Si hizo clic en la imagen ya cargada, abrir lightbox en pantalla completa
      if (target.classList.contains('dish-img') && img.src) {
        e.stopPropagation();
        if (typeof (window as any).openDishLightbox === 'function') {
          const title = card.querySelector('h3')?.textContent || '';
          const price = card.querySelector('.ds-price-badge')?.textContent || '';
          (window as any).openDishLightbox(img.src, title, price);
        }
        return;
      }

      const isExpanded = container.classList.contains('is-expanded');

      if (isExpanded) {
        // Colapsar
        container.classList.remove('is-expanded');
        container.style.maxHeight = '0px';
        container.style.opacity = '0';
        if (toggleText) toggleText.textContent = 'Ver foto';
        if (toggleArrow) toggleArrow.classList.remove('rotate-180');
      } else {
        // Expandir
        container.classList.add('is-expanded');
        container.style.maxHeight = '360px';
        container.style.opacity = '1';
        if (toggleText) toggleText.textContent = 'Ocultar foto';
        if (toggleArrow) toggleArrow.classList.add('rotate-180');

        // Descargar la imagen SOLAMENTE la primera vez que se hace clic
        if (!img.src && img.dataset.src) {
          img.onload = () => {
            img.classList.remove('opacity-0');
            img.classList.add('opacity-100');
            if (loader) loader.classList.add('hidden');
          };
          img.src = img.dataset.src;
        }
      }
    });
  });
</script>
