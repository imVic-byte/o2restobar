---
import siteInfo from "../../data/site_info.json";
---

<!-- Barra Superior Informativa -->
<div
  class="w-full text-white bg-zinc-950/90 border-b border-accent/20 text-xs py-2 px-4 text-text-secondary hidden md:block relative z-50"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-6">
      <span class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-accent"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {siteInfo.address.full}
      </span>
      <span class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-accent"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Abierto todos los días desde las 09:00 AM
      </span>
    </div>
    <div class="flex items-center gap-5">
      <a
        href={siteInfo.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors flex items-center gap-1.5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-accent"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
          ></path>
        </svg>
        WhatsApp: {siteInfo.contact.phoneDisplay}
      </a>
      <a
        href={siteInfo.contact.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors flex items-center gap-1.5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-accent"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path>
        </svg>
        {siteInfo.contact.instagram.handle}
      </a>
    </div>
  </div>
</div>

<!-- Header / Barra de Navegación Principal -->
<header
  class="sticky top-0 left-0 w-full bg-zinc-950/85 backdrop-blur-md z-50 border-b border-accent/25 shadow-md shadow-black/50 transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logotipo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/images/logo.webp"
        alt="O2 Restobar Logo"
        class="h-11 w-auto object-contain group-hover:scale-105 transition-transform"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hidden sm:flex flex-col">
        <span
          class="font-headings font-extrabold text-lg tracking-widest text-text-primary group-hover:text-accent transition-colors"
        >
          O2 RESTOBAR
        </span>
        <span
          class="text-[12px] text-accent/80 font-body tracking-wider uppercase"
        >
          Oxígeno Multiespacio
        </span>
      </div>
    </a>

    <!-- Navegación de Escritorio -->
    <nav
      class="hidden lg:flex items-center gap-7 text-sm font-headings tracking-wider uppercase text-text-secondary"
    >
      <a href="#inicio" class="hover:text-accent font-body transition-colors"
        >Inicio</a
      >
      <a href="#propuesta" class="hover:text-accent font-body transition-colors"
        >Propuesta</a
      >
      <a href="#nosotros" class="hover:text-accent font-body transition-colors"
        >Sobre O2</a
      >
      <a href="#contacto" class="hover:text-accent font-body transition-colors"
        >Horarios</a
      >
    </nav>

    <!-- Botón CTA de Reserva / Carta -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={siteInfo.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative rounded-md inline-flex items-center justify-center px-4 py-2 border border-accent text-accent font-headings text-xs font-bold uppercase tracking-widest bg-zinc-950/60 hover:bg-accent hover:text-black transition-all shadow-[0_0_12px_rgba(250,204,21,0.2)] active:scale-95 group"
      >
        <span class="relative z-10 flex items-center gap-1.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
          Reservar Mesa
        </span>
        <span
          class="absolute inset-0 bg-accent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300origin-left"
        ></span>
      </a>
    </div>

    <!-- Botón Menú Móvil -->
    <button
      id="mobileMenuToggle"
      aria-label="Abrir menú"
      class="lg:hidden p-2 text-text-primary hover:text-accent focus:outline-none"
    >
      <svg
        id="menuOpenIcon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="menuCloseIcon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Desplegable Móvil -->
  <div
    id="mobileMenuDrawer"
    class="lg:hidden hidden bg-zinc-950/98 border-b border-accent/30 px-6 py-6 transition-all duration-300 shadow-2xl backdrop-blur-xl"
  >
    <div
      class="flex flex-col gap-4 font-headings text-sm uppercase tracking-wider"
    >
      <a
        href="#inicio"
        class="mobile-nav-link text-text-secondary hover:text-accent py-2 border-b border-zinc-800/80"
        >Inicio</a
      >
      <a
        href="#propuesta"
        class="mobile-nav-link text-text-secondary hover:text-accent py-2 border-b border-zinc-800/80"
        >Nuestra Propuesta</a
      >
      <a
        href="#nosotros"
        class="mobile-nav-link text-text-secondary hover:text-accent py-2 border-b border-zinc-800/80"
        >Sobre O2</a
      >
      <a
        href="#contacto"
        class="mobile-nav-link text-text-secondary hover:text-accent py-2 border-b border-zinc-800/80"
        >Horarios & Ubicación</a
      >
      <a
        href="/menu"
        class="mobile-nav-link text-accent py-2.5 flex items-center justify-between font-bold border-b border-accent/30"
      >
        <span>Explorar Carta Digital</span>
        <span>→</span>
      </a>
      <div class="pt-2 flex flex-col gap-2.5">
        <a
          href={siteInfo.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center py-2.5 border border-accent bg-accent/15 text-accent font-bold rounded-xs tracking-wider"
        >
          Reservar Mesa por WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobileMenuToggle");
  const drawer = document.getElementById("mobileMenuDrawer");
  const openIcon = document.getElementById("menuOpenIcon");
  const closeIcon = document.getElementById("menuCloseIcon");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  if (toggleBtn && drawer && openIcon && closeIcon) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = drawer.classList.contains("hidden");
      if (isHidden) {
        drawer.classList.remove("hidden");
        openIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      } else {
        drawer.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }
    });

    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        drawer.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }
</script>
