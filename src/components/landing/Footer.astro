---
import siteInfo from "../../data/site_info.json";
---

<footer
  id="contacto"
  class="bg-zinc-950 border-t border-accent/30 pt-16 pb-12 px-4 relative z-10"
>
  <div class="max-w-6xl mx-auto flex flex-col gap-12">
    <!-- Grid Principal del Footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      <!-- Columna 1: Marca & Eslogan (lg:col-span-4) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.webp"
            alt="O2 Restobar"
            class="h-12 w-auto object-contain"
          />
          <div class="flex flex-col">
            <span
              class="font-headings font-extrabold text-base tracking-widest text-text-primary"
            >
              O2 RESTOBAR
            </span>
            <span
              class="text-[10px] text-accent font-body tracking-wider uppercase"
            >
              Oxígeno Multiespacio
            </span>
          </div>
        </div>

        <p class="text-text-secondary font-body text-xs leading-relaxed mt-2">
          Gastronomía diversa, coctelería de autor, terraza pet-friendly con
          vista al mar y la mejor energía nocturna en la Costanera de Coquimbo.
        </p>
      </div>

      <!-- Columna 2: Horarios de Atención (lg:col-span-3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h4
          class="font-headings font-bold text-sm uppercase tracking-wider text-accent flex items-center gap-2"
        >
          <span>✦</span> Horarios de Atención
        </h4>

        <div
          class="flex flex-col gap-2.5 text-xs text-text-secondary font-body mt-1"
        >
          <div class="flex flex-col border-b border-zinc-800 pb-2">
            <span class="font-semibold text-text-primary">Viernes y Sábado</span
            >
            <span class="text-bold font-body text-accent"
              >09:00 AM – 05:00 AM</span
            >
          </div>

          <div class="flex flex-col border-b border-zinc-800 pb-2">
            <span class="font-semibold text-text-primary">Jueves</span>
            <span class="text-bold font-body text-accent"
              >09:00 AM – 04:00 AM</span
            >
          </div>

          <div class="flex flex-col">
            <span class="font-semibold text-text-primary"
              >Domingo a Miércoles</span
            >
            <span class="text-bold font-body text-accent"
              >09:00 AM – 02:30 AM</span
            >
          </div>
        </div>
      </div>

      <!-- Columna 3: Contacto & Ubicación (lg:col-span-3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h4
          class="font-headings font-bold text-sm uppercase tracking-wider text-accent flex items-center gap-2"
        >
          <span>✦</span> Ubicación & Contacto
        </h4>

        <div
          class="flex flex-col gap-3 text-xs text-text-secondary font-body mt-1"
        >
          <div class="flex items-start gap-2.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-accent shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <p class="text-text-primary font-semibold">
                {siteInfo.address.full}
              </p>
              <a
                href={siteInfo.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline inline-flex items-center gap-1 text-[11px] mt-0.5"
              >
                Ver en Google Maps →
              </a>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-accent shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href={`tel:${siteInfo.contact.phone}`}
              class="hover:text-accent transition-colors text-text-primary"
            >
              {siteInfo.contact.phoneDisplay}
            </a>
          </div>

          <!-- Redes Sociales -->
          <div class="flex items-center gap-3 pt-2">
            <a
              href={siteInfo.contact.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de O2 Restobar"
              class="w-9 h-9 rounded-none border border-accent/40 bg-zinc-900 flex items-center justify-center text-accent hover:bg-accent hover:text-black transition-all"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
            </a>

            <a
              href={siteInfo.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp de O2 Restobar"
              class="w-9 h-9 rounded-none border border-accent/40 bg-zinc-900 flex items-center justify-center text-accent hover:bg-accent hover:text-black transition-all"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna 4: Enlaces Rápidos (lg:col-span-2) -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <h4
          class="font-headings font-bold text-sm uppercase tracking-wider text-accent flex items-center gap-2"
        >
          <span>✦</span> Navegación
        </h4>

        <ul class="flex flex-col gap-2 text-xs font-body text-text-secondary">
          <li>
            <a href="#inicio" class="hover:text-accent transition-colors"
              >Inicio</a
            >
          </li>
          <li>
            <a href="#propuesta" class="hover:text-accent transition-colors"
              >Nuestra Propuesta</a
            >
          </li>
          <li>
            <a href="#nosotros" class="hover:text-accent transition-colors"
              >Sobre O2 Restobar</a
            >
          </li>
          <li>
            <a href="/menu?tab=rooftop" class="hover:text-accent transition-colors"
              >Carta Rooftop</a
            >
          </li>
          <li>
            <a href="/menu?tab=burger" class="hover:text-accent transition-colors"
              >Carta Burger+</a
            >
          </li>
          <li>
            <a href="/menu?tab=bar" class="hover:text-accent transition-colors"
              >Carta de Bar</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra Inferior de Copyright -->
    <div
      class="border-t border-zinc-900 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-text-secondary/60 font-body"
    >
      <p>
        © 2026 {siteInfo.name} ({siteInfo.legalName}). Todos los derechos
        reservados.
      </p>
      <p class="flex items-center gap-2">
        <span>Coquimbo, Región de Coquimbo, Chile</span>
        <span>•</span>
        <span class="text-accent">Oxígeno Multiespacio</span>
      </p>
    </div>
  </div>
</footer>
