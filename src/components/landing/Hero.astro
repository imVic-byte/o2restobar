---
import siteInfo from "../../data/site_info.json";
---

<section
  id="inicio"
  class="relative min-h-[92vh] md:min-h-[calc(100vh-45px)] flex items-center justify-center overflow-hidden border-b border-accent/20"
>
  <!-- Fotografía Gourmet a Pantalla Completa (Hero Background) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/HERO.webp"
      alt="Especialidad Gastronómica O2 Restobar"
      class="w-full h-full object-cover object-center lg:object-[80%_center] filter brightness-[0.85] contrast-[1.08] transition-transform duration-1000 scale-100"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Degradados Multicapa para Contraste y Fusión Perfecta -->
    <!-- 1. Degradado horizontal (de izquierda a derecha): Resalta el texto con fondo oscuro y revela el plato a la derecha -->
    <div
      class="absolute inset-0 bg from-zinc-950 via-zinc-950/90 md:via-zinc-950/80 to-zinc-950/40 lg:to-transparent"
    >
    </div>

    <!-- 2. Degradado vertical: Fundido suave con la barra superior y la siguiente sección -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/50 to-zinc-950/70"
    >
    </div>

    <!-- 3. Destello cálido dorado sutil -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(250,204,21,0.15),transparent_65%)] pointer-events-none"
    >
    </div>
  </div>

  <!-- Acentos Art-Decó en las 4 esquinas de la pantalla -->
  <div
    class="hidden md:block absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-accent/60 z-10 pointer-events-none"
  >
  </div>
  <div
    class="hidden md:block absolute top-6 right-6 w-8 h-8 border-t-2 border-r-2 border-accent/60 z-10 pointer-events-none"
  >
  </div>
  <div
    class="hidden md:block absolute bottom-8 left-6 w-8 h-8 border-b-2 border-l-2 border-accent/60 z-10 pointer-events-none"
  >
  </div>
  <div
    class="hidden md:block absolute bottom-8 right-6 w-8 h-8 border-b-2 border-r-2 border-accent/60 z-10 pointer-events-none"
  >
  </div>

  <!-- Contenido Principal Superpuesto -->
  <div
    class="relative z-10 max-w-6xl w-full mx-auto px-4 py-16 sm:py-24 flex flex-col justify-center"
  >
    <div class="max-w-2xl flex flex-col items-start gap-6">
      <!-- Subtítulo / Badge de Identidad -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-zinc-950/80 border border-accent/60 rounded-none text-accent font-headings text-xs font-bold uppercase tracking-widest shadow-[0_0_15px_rgba(250,204,21,0.25)] backdrop-blur-md"
      >
        <span class="text-xs">✦</span>
        <span>Oxígeno Multiespacio · Coquimbo</span>
        <span class="text-xs">✦</span>
      </div>

      <!-- Título Principal -->
      <h1
        class="font-headings font-black text-3xl sm:text-5xl lg:text-6xl text-text-primary tracking-tight leading-[1.1] uppercase"
      >
        Sabor Único, <span
          class="text-accent underline decoration-accent/40 decoration-wavy underline-offset-8"
          >Coctelería</span
        > & Música Frente al Mar
      </h1>

      <!-- Descripción Sensorial con Contraste Elevado -->
      <p
        class="text-text-secondary font-body text-base sm:text-lg leading-relaxed max-w-xl"
      >
        Ubicados en plena Costanera de Coquimbo. Disfruta de una experiencia
        completa: gastronomía gourmet, coctelería de autor, terraza pet-friendly
        con vista al mar y un ambiente nocturno vibrante con DJs en vivo.
      </p>

      <!-- Botones de Acción / CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
        <!-- CTA Principal: Menú -->
        <a
          href="/menu"
          class="relative group overflow-hidden px-8 py-4 bg-accent text-zinc-950 font-headings font-black text-xs sm:text-sm uppercase tracking-wider shadow-[0_0_25px_rgba(250,204,21,0.4)] hover:bg-accent-hover transition-all active:scale-95 flex items-center gap-2"
        >
          <span>Explorar Carta Digital</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 group-hover:translate-x-1.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
          <div
            class="absolute inset-0 w-1/2 bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none animate-shimmer"
          >
          </div>
        </a>

        <!-- CTA Secundario: Reservas -->
        <a
          href={siteInfo.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-4 bg-zinc-950/85 border border-zinc-700 hover:border-accent text-text-primary hover:text-accent font-headings font-bold text-xs sm:text-sm uppercase tracking-wider backdrop-blur-md transition-all active:scale-95 flex items-center gap-2 shadow-lg"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-accent"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
          <span>Reservar por WhatsApp</span>
        </a>
      </div>

      <!-- Micro badges de características destacadas -->
      <div
        class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-accent/25 w-full mt-2 text-xs text-text-secondary/90"
      >
        <div class="flex items-center gap-2">
          <span class="text-accent text-base">🌊</span>
          <span>Frente al mar</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-accent text-base">🐾</span>
          <span>Pet Friendly</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-accent text-base">🎧</span>
          <span>DJs en vivo</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-accent text-base">🍸</span>
          <span>Bar & Tragos</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tag Flotante del Plato en la esquina inferior derecha (Desktop) -->
  <div
    class="hidden lg:flex absolute bottom-8 right-8 z-10 items-center gap-3 px-4 py-2.5 bg-zinc-950/80 backdrop-blur-md border border-accent/40 shadow-2xl"
  >
    <div class="w-2 h-2 rounded-full bg-accent animate-ping"></div>
    <div class="flex flex-col">
      <span
        class="text-[10px] font-headings uppercase tracking-widest text-accent font-bold"
        >Especialidad de la Casa</span
      >
      <span class="text-xs font-body text-text-primary"
        >Cocina de Autor & Sabores del Mar</span
      >
    </div>
  </div>

  <!-- Indicador sutil de scroll hacia abajo -->
  <a
    href="#propuesta"
    aria-label="Ir a Nuestra Propuesta"
    class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1 text-accent/80 hover:text-accent text-[10px] font-headings uppercase tracking-widest transition-all group"
  >
    <span class="group-hover:translate-y-0.5 transition-transform"
      >Descubrir</span
    >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 animate-bounce"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>
</section>
